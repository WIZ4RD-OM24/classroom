#--------------------------------------------------------------------
# Environment configuration template
#
# Copy this file to `.env` in the project root and edit the values.
# `.env` is git-ignored: it holds per-machine settings and secrets and
# must never be committed.
#
#     cp env .env
#
# Settings are commented out by default. Remove the leading '#' to
# override the matching value in app/Config.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
# `development` shows the debug toolbar and full error pages.
# Use `production` on a live server: it hides stack traces, which would
# otherwise disclose file paths and query fragments to visitors.

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
# baseURL must match how the site is actually reached, including the
# trailing slash. Point your web server (or virtual host) at the
# `public/` directory, never at the project root.

app.baseURL = 'http://localhost:8080/'

# Send cookies only over HTTPS. Turn both of these on in production.
# app.forceGlobalSecureRequests = true
# app.cookieSecure = true

# app.sessionDriver = 'CodeIgniter\Session\Handlers\FileHandler'
# app.sessionCookieName = 'ci_session'
# app.sessionExpiration = 7200
# app.sessionSavePath = null
# app.sessionMatchIP = false
# app.sessionTimeToUpdate = 300
# app.sessionRegenerateDestroy = false

# app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
# MySQL / MariaDB — the default. Create the database first:
#     CREATE DATABASE classroom CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# then run `php spark migrate`.

database.default.hostname = localhost
database.default.database = classroom
database.default.username = root
database.default.password = ''
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# SQLite alternative, for local work without a database server. The
# value is resolved relative to `writable/`, and must not contain a
# path separator.
#
# database.default.DBDriver = SQLite3
# database.default.database = classroom.sqlite

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------
# Generate with: php spark key:generate

# encryption.key =

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------
# 1 = emergency only ... 9 = everything. Use 4 (warnings and worse) in
# production; 9 is noisy and writes request detail to disk.

# logger.threshold = 4

